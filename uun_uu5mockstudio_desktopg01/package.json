{
  "name": "uu5mockapp",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "main": "src/main/main.mjs",
  "scripts": {
    "start": "electron .",
    "spike:agent": "node scripts/spike-agent.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "pack": "electron-builder --config electron-builder.config.cjs --dir",
    "dist:mac": "electron-builder --config electron-builder.config.cjs --mac --arm64",
    "dist:mac:x64": "electron-builder --config electron-builder.config.cjs --mac --x64",
    "dist:win": "electron-builder --config electron-builder.config.cjs --win",
    "dist:linux": "electron-builder --config electron-builder.config.cjs --linux",
    "icon": "electron scripts/make-icon.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@babel/parser": "^8.0.7",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "description": "Desktop app for designing uu5 / uuGDS user interfaces with an AI model (Claude Code)",
  "author": "uu5Mock Studio",
  "license": "GPL-3.0-only"
}
